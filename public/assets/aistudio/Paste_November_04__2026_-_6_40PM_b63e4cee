    }
  };

  const handlePoQtyChange = (code, val) => {
    const qty = Math.max(0, parseFloat(val) || 0);
    setPoItems(prev => prev.map(p => p.code === code ? {...p, orderQtyPrimary: qty} : p));
  };
  
  const handlePoPriceChange = (code, val) => {
