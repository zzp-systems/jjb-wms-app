import React, { useState, useMemo } from 'react';

import { 

  BarChart3, Download, Calendar, Printer, 

  ArrowDownRight, ArrowUpRight, Scale, FileText

} from 'lucide-react';



export default function ReportsModule({ 

  receivingReports, 

  withdrawals, 

  batchOrders, 

  adjustments 

}) {

  const [timeframe, setTimeframe] = useState('MONTH'); // WEEK, MONTH, QUARTER, YEAR

  const [reportType, setReportType] = useState('ALL'); // ALL, RECEIVING, WITHDRAWALS, BATCHING, ADJUSTMENTS



  // Helper to get current date bounds based on timeframe

  const getDateBounds = () => {

    const now = new Date('2026-11-03'); // Using seed date as baseline

    const start = new Date(now);

    

    if (timeframe === 'WEEK') {

      start.setDate(now.getDate() - now.getDay()); // Start of week (Sunday)

    } else if (timeframe === 'MONTH') {

      start.setDate(1);

    } else if (timeframe === 'QUARTER') {

      const quarterMonth = Math.floor(now.getMonth() / 3) * 3;

      start.setMonth(quarterMonth, 1);

    } else if (timeframe === 'YEAR') {

      start.setMonth(0, 1);

    }

    

    return { start, end: now };

  };



  const { start, end } = getDateBounds();



  const filterByDate = (dateString) => {

    if (!dateString) return true;

    const d = new Date(dateString);

    return d >= start && d <= end;

  };



  // Filtered Data

  const filteredReceiving = useMemo(() => receivingReports.filter(r => filterByDate(r.date)), [receivingReports, timeframe]);

  const filteredWithdrawals = useMemo(() => withdrawals.filter(w => filterByDate(w.date)), [withdrawals, timeframe]);

  const filteredBatchOrders = useMemo(() => batchOrders.filter(b => filterByDate(b.requestDate)), [batchOrders, timeframe]);

  const filteredAdjustments = useMemo(() => adjustments.filter(a => filterByDate(a.date)), [adjustments, timeframe]);



  // Export CSV Helper

  const downloadCSV = (data, headers, filename) => {

    if (data.length === 0) return alert("No data available for this timeframe.");

    const csvRows = [];

    csvRows.push(headers.join(','));

    for (const row of data) {

      const values = headers.map(header => {

        const val = row[header] || '';

        return `"${String(val).replace(/"/g, '""')}"`;

      });

      csvRows.push(values.join(','));

