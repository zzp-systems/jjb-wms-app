/**
 * ============================================================================
 * 1. FAST QUEUE-FIRST INGESTION ENDPOINT (doPost)
 * ============================================================================
 * Acquires LockService.waitLock(5000), validates payload shape, appends to QUEUE,
 * releases lock immediately, and returns {"status": "queued"} or {"status": "busy", "retry": true}.
 */
function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    try {
      lock.waitLock(5000);
    } catch (lockErr) {
      return jsonResponse_({
        status: "busy",
        retry: true,
        message: "Server mutex lock busy (waitLock 5000ms exceeded). Client should retry with backoff."
      });
    }

    if (!e || !e.postData || !e.postData.contents) {
      return jsonResponse_({ status: "error", message: "Empty request body." });
    }

    const body = JSON.parse(e.postData.contents);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let queueSheet = ss.getSheetByName("QUEUE");
    if (!queueSheet) {
      ensureAllSheetsExist_(ss);
      queueSheet = ss.getSheetByName("QUEUE");
    }

    const queueId = body.queueId || ("Q-" + Utilities.getUuid());
    const nowPht = Utilities.formatDate(new Date(), TIMEZONE, "yyyy-MM-dd HH:mm:ss");
    const terminalId = body.terminalId || "TERM-WEB";
    const actorName = body.actorName || body.actor || "Jade Q. Dela Cruz";
    const actorRole = body.actorRole || body.role || "Terminal 1 · Warehouse Supervisor";
    const actionType = body.actionType || body.action || "STATE_SYNC";

    queueSheet.appendRow([
      queueId,
      nowPht,
      terminalId,
      actorName,
      actorRole,
      actionType,
      JSON.stringify(body),
      "QUEUED",
      "",
      ""
    ]);

    SpreadsheetApp.flush();

    return jsonResponse_({
      status: "queued",
      queueId: queueId,
      timestamp: nowPht
    });

  } catch (err) {
    return jsonResponse_({
      status: "error",
      message: err.toString()
    });
  } finally {
    try {
      lock.releaseLock();
    } catch (ignore) {}
  }
}

/**
 * ============================================================================
 * 2. LIVE READ & STATUS ENDPOINT (doGet)
 * ============================================================================
 */
function doGet(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const queueSheet = ss.getSheetByName("QUEUE");
  let queuedCount = 0;

  if (queueSheet && queueSheet.getLastRow() > 1) {
    const statuses = queueSheet.getRange(2, 8, queueSheet.getLastRow() - 1, 1).getValues();
    queuedCount = statuses.filter(r => r[0] === "QUEUED").length;
  }

  return jsonResponse_({
    status: "online",
    workbookName: ss.getName(),
    workbookUrl: ss.getUrl(),
    pendingQueueCount: queuedCount,
    syncState: queuedCount > 0 ? "ONLINE — QUEUED" : "ONLINE — SYNCED",
    timestamp: Utilities.formatDate(new Date(), TIMEZONE, "yyyy-MM-dd HH:mm:ss")
  });
}

/**
 * ============================================================================
 * 3. ASYNCHRONOUS 1-MINUTE BATCH WORKER (processQueueBatch)
 * ============================================================================
 * Processes up to 25 QUEUED rows per run, validates FEFO / dual-UoM / scale gates,
 * commits rows to the master sheets, and checks if it is 23:45 PHT for EOD dispatch.
 */
function processQueueBatch() {
  // Check if 23:45 PHT auto-email should fire on this minute tick
  check2345MinuteTick_();

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return;

  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const queueSheet = ss.getSheetByName("QUEUE");
    if (!queueSheet || queueSheet.getLastRow() <= 1) return;

    const data = queueSheet.getDataRange().getValues();
    const nowPht = Utilities.formatDate(new Date(), TIMEZONE, "yyyy-MM-dd HH:mm:ss");
    let processedCount = 0;

    for (let i = 1; i < data.length && processedCount < 25; i++) {
      const row = data[i];
      const status = row[7];

      if (status === "QUEUED") {
        const actionType = String(row[5] || "");
        const rawJson = row[6];

        try {
          const body = JSON.parse(rawJson);
          const payload = body.payload || body;

          routeAndCommitAction_(ss, actionType, body, payload, nowPht);

          queueSheet.getRange(i + 1, 8).setValue("SYNCED");
          queueSheet.getRange(i + 1, 9).setValue(nowPht);
          queueSheet.getRange(i + 1, 10).setValue("OK");
        } catch (err) {
          queueSheet.getRange(i + 1, 8).setValue("VALIDATION_ERROR");
          queueSheet.getRange(i + 1, 9).setValue(nowPht);
          queueSheet.getRange(i + 1, 10).setValue(err.toString());
        }
        processedCount++;
      }
    }

    SpreadsheetApp.flush();
  } catch (err) {
    console.error("processQueueBatch error: " + err.toString());
  } finally {
    try {
      lock.releaseLock();
    } catch (ignore) {}
  }
}

/**
 * Routes each queued transaction to its exact ledger sheet(s).
 */
function routeAndCommitAction_(ss, actionType, envelope, payload, nowPht) {
  ensureAllSheetsExist_(ss);

  // Always record in immutable Audit_Log
  const auditSheet = ss.getSheetByName("Audit_Log");
  auditSheet.appendRow([
    envelope.queueId || ("LOG-" + Date.now()),
    envelope.timestamp || nowPht,
    envelope.actorName || envelope.actor || "Jade Q. Dela Cruz",
    envelope.actorRole || envelope.role || "Terminal 1 · Warehouse Supervisor",
    actionType,
    envelope.details || JSON.stringify(payload).slice(0, 500)
  ]);

  // 1. INBOUND RECEIVING (Form-REC-001)
  if (actionType === "INBOUND_RECEIVING" || actionType === "RECEIVING_REPORT" || actionType === "STOCK_IN") {
    const stockInSheet = ss.getSheetByName("Stock In");
    const rrSheet = ss.getSheetByName("Receiving_Reports");

    if (payload.reportNo && rrSheet) {
      rrSheet.appendRow([
        payload.reportNo,
        payload.date || nowPht.slice(0, 10),
        payload.time || nowPht.slice(11, 16),
        payload.poNo || "",
        payload.drNo || "",
        payload.supplier || "",
        payload.invoiceNo || "",
        payload.deliveryVehicle || "",
        payload.overallStatus || "ACCEPTED CLEAN",
        payload.totalPaid || 0,
        payload.receiver || "Jade Q. Dela Cruz",
        payload.qcSignoff || "Jade Q. Dela Cruz"
      ]);
    }

    const items = payload.items || [payload];
    items.forEach(item => {
      if (!item.materialCode) return;
      const netQty = Number(item.secondaryQty || item.totalNetQty || (item.primaryQty * (item.conversionFactor || 1)));
      const tempGate = item.materialCode === "RM-FAT-001"
        ? `${item.chilledTemp || "-1.0°C"} / Cellophane Sticker: ${item.butterCellophaneSticker !== false ? "Verified" : "Missing"}`
        : item.materialCode === "RM-DRY-001"
        ? `Egg Rinse: ${item.eggRinsePassed !== false ? "Rinsed / Pass" : "Pending"}`
        : "Ambient / Pass";

      stockInSheet.appendRow([
        payload.date || item.dateReceived || nowPht.slice(0, 10),
        payload.poNo || item.poDrNumber || "",
        item.materialCode,
        item.brand || item.itemBrand || "",
        item.name || item.itemName || "",
        payload.supplier || item.supplierName || "",
        item.lotNumber || item.supplierLotNumber || "",
        item.expiryDate || item.expirationDate || "",
        item.primaryQty || item.primaryQtyReceived || 0,
        item.primaryUom || item.primaryUoM || "",
        netQty,
        item.storageRoom || "Dry Room 1",
        tempGate,
        payload.receiver || "Jade Q. Dela Cruz",
        item.coaPassed !== false ? "Verified on File" : "Pending",
        "Charge Invoice",
        payload.invoiceNo || "",
        item.unitPrice || item.itemPrice || 0
      ]);
    });
  }

  // 2. STOCK RELEASE / WITHDRAWAL & JADE BULK APPROVAL (Form-WAR-001)
  else if (
    actionType === "STOCK_OUT_ISSUANCE" ||
    actionType === "BULK_REQUISITION_REQUESTED" ||
    actionType === "BULK_REQUISITION_APPROVED" ||
    actionType === "STOCK_OUT"
  ) {
    const stockOutSheet = ss.getSheetByName("Stock Out");
    const items = payload.items || [payload];

    // Only deduct from Stock Out when status is ISSUED & RECONCILED (not while PENDING_APPROVAL)
    if (payload.status !== "PENDING_APPROVAL") {
      items.forEach(item => {
        if (!item.materialCode) return;
        stockOutSheet.appendRow([
          payload.date || payload.releaseDate || nowPht.slice(0, 10),
          payload.slipNo || payload.issuanceSlipNo || "",
          payload.requestingEntity || payload.targetProductLine || "",
          item.materialCode,
          item.name || item.itemName || "",
          item.lotNumber || item.lotBatchIssued || "FEFO-LOT",
          item.qtyPrimary || "",
          item.primaryUom || "",
          item.qtyIssuedSec || item.quantityIssuedNet || 0,
          payload.issuedBy || "Jade Q. Dela Cruz",
          payload.receivedBy || payload.receivedByBaker || "Romeo B. Malusay"
        ]);
      });
    }

    // If linked to a Batch Order, update Batching_Orders sheet status
    if (payload.linkedOrderId || payload.orderId) {
      upsertBatchOrderRow_(ss, payload);
