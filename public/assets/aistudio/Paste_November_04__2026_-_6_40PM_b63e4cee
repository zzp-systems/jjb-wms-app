            </div>

            <div className="border-t pt-3 flex justify-end">

              <button onClick={() => window.print()} className="bg-[#3D1C52] text-white text-xs font-bold px-4 py-2 rounded flex items-center gap-1.5">

                <Printer size={13} /> Print Tag

              </button>

            </div>

          </div>

        </div>

      )}

    </div>

  );

}

