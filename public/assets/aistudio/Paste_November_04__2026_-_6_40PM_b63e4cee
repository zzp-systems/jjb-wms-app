/**
 * Jang-Jang Bakeshop Warehouse WMS v4.0 - Queue-First Google Apps Script Backend
 * Handles doPost with LockService.waitLock(5000), appends to QUEUE, and processes async batches.
 */

function setupTrigger() {
  // Remove existing triggers to prevent duplicates
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => ScriptApp.deleteTrigger(t));
  
  // Create 1-minute time-driven trigger for asynchronous queue batch processing
  ScriptApp.newTrigger('processQueueBatch')
    .timeBased()
    .everyMinutes(1)
    .create();
    
  SpreadsheetApp.getActiveSpreadsheet().toast("Queue batch trigger initialized successfully!", "JJB System", 5);
}

function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    // Acquire lock with 5-second timeout to handle high terminal concurrency
    const acquired = lock.waitLock(5000);
    if (!acquired) {
      return ContentService.createTextOutput(JSON.stringify({
        status: "busy",
        retry: true,
        message: "Server lock busy. Please retry with exponential backoff."
      })).setMimeType(ContentService.MimeType.JSON);
    }
    
    const payload = JSON.parse(e.postData.contents);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let queueSheet = ss.getSheetByName("QUEUE");
    
    if (!queueSheet) {
      queueSheet = ss.insertSheet("QUEUE");
      queueSheet.appendRow(["Queue ID", "Timestamp", "Terminal ID", "Actor Name", "Actor Role", "Action Type", "Payload JSON", "Status", "Processed At", "Error Message"]);
      queueSheet.getRange(1, 1, 1, 10).setFontWeight("bold").setBackground("#5B2E7A").setFontColor("#FFFFFF");
    }
    
    const queueId = payload.queueId || "Q-" + Utilities.getUuid();
    const timestamp = payload.timestamp || new Date().toISOString();
    const terminalId = payload.terminalId || "TERM-UNKNOWN";
    const actorName = payload.actorName || "System";
    const actorRole = payload.actorRole || "Operator";
    const actionType = payload.actionType || "GENERIC_ACTION";
    
    // Append row to QUEUE sheet for async processing (< 400ms execution time)
    queueSheet.appendRow([
      queueId,
      timestamp,
      terminalId,
      actorName,
      actorRole,
      actionType,
      JSON.stringify(payload),
      "QUEUED",
      "",
      ""
    ]);
    
    SpreadsheetApp.flush();
    
    return ContentService.createTextOutput(JSON.stringify({
      status: "queued",
      queueId: queueId,
      message: "Transaction successfully queued for server batch commitment."
    })).setMimeType(ContentService.MimeType.JSON);
    
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: err.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  } finally {
    try {
      lock.releaseLock();
    } catch(ex) {}
  }
}

function processQueueBatch() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2000)) return; // Skip if another batch worker is running
  
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const queueSheet = ss.getSheetByName("QUEUE");
    if (!queueSheet) return;
    
    const data = queueSheet.getDataRange().getValues();
    if (data.length <= 1) return;
    
    const now = new Date().toISOString();
    let processedCount = 0;
    
    // Process up to 25 queued items per 1-minute trigger run
    for (let i = 1; i < data.length && processedCount < 25; i++) {
      const row = data[i];
      const status = row[7];
      
      if (status === "QUEUED") {
        const queueId = row[0];
        const actionType = row[5];
        const payloadStr = row[6];
        
        try {
          const payload = JSON.parse(payloadStr);
          
          // Execute domain routing based on action type
          if (actionType === "RECEIVING_REPORT" || actionType === "STOCK_IN") {
            commitStockIn(ss, payload);
          } else if (actionType === "STOCK_OUT" || actionType === "BATCH_ISSUANCE") {
            commitStockOut(ss, payload);
          } else if (actionType === "SCALE_CALIBRATION") {
            commitCalibration(ss, payload);
          } else if (actionType === "NON_CONFORMANCE_NCR") {
            commitNCR(ss, payload);
          }
          
          // Mark QUEUED row as SYNCED
          queueSheet.getRange(i + 1, 8).setValue("SYNCED");
          queueSheet.getRange(i + 1, 9).setValue(now);
          queueSheet.getRange(i + 1, 10).setValue("");
          
        } catch (err) {
          queueSheet.getRange(i + 1, 8).setValue("VALIDATION_ERROR");
          queueSheet.getRange(i + 1, 9).setValue(now);
          queueSheet.getRange(i + 1, 10).setValue(err.toString());
        }
        processedCount++;
      }
    }
    SpreadsheetApp.flush();
  } catch (ex) {
    console.error("Error in processQueueBatch: " + ex.toString());
  } finally {
    lock.releaseLock();
  }
}

