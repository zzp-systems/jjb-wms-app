                </thead>
                <tbody className="divide-y divide-gray-200">
                  {todaysBatchedAndReleased.map(b => (
                    <tr key={b.orderId} className="hover:bg-gray-50">
                      <td className="p-2.5 font-mono font-bold text-[#5B2E7A]">{b.batchTagId || 'TAG-PENDING'}</td>
                      <td className="p-2.5">
