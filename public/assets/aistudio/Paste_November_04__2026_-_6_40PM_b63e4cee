        const updatedLots = [
          ...(invItem.lots || []),
          {
            lotNumber: receivedItem.lotNumber,
            expiryDate: receivedItem.expiryDate,
            qtySec: netAdded,
            location: receivedItem.binLocation || 'Pallet Staging'
          }
        ].sort((a, b) => new Date(a.expiryDate) - new Date(b.expiryDate));

