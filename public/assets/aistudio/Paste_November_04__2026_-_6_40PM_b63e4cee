  const handleForensicFix = () => {
    setInventory(prev => prev.map(item => {
      if (item.code === "RM-LEV-001") return { ...item, bal: 40 }; // Fix negative yeast
      if (item.code === "PM-PAP-002") return { ...item, bal: 1500 }; // Fix negative pattern paper
      return item;
